# Victory core
DATABASE_URL=postgres://victory:REDACTED@127.0.0.1:5432/victory?sslmode=disable
PORT=8081
STORAGE_ROOT=/opt/victory/storage
VICTORY_BASE_URL=

# Session / cookies
SESSION_COOKIE_SECURE=
# Backward-compatible alias currently read by the backend if SESSION_COOKIE_SECURE is unset.
COOKIE_SECURE=

# Operator bootstrap
OPERATOR_HANDLE=
OPERATOR_USER_ID=
DEFAULT_LOCATION_SLUG=victory-theater

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=
DISCORD_OAUTH_SCOPES="identify email"
DISCORD_OAUTH_ENABLED=

# Discord server / bot / gateway
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_BOT_PERMISSIONS=16
# Keep channel-management permissions enabled for Discord audio repair; Victory still does not stream audio.
DISCORD_BOT_REDIRECT_URL=
DISCORD_PUBLIC_KEY=
DISCORD_SERVER_LINK_ENABLED=
DISCORD_GATEWAY_ENABLED=
# Include GUILD_VOICE_STATES (641) so the Presence tray can show live Discord voice participants.
DISCORD_GATEWAY_INTENTS=641
DISCORD_GATEWAY_URL=
