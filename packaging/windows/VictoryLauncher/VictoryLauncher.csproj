<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kernel 100, windows-native branch: this is the Windows tray
    application Velopack packages and updates, the thing a consumer
    actually double-clicks. It never runs Victory's own logic itself; it
    downloads/initializes Postgres on first run and supervises both
    Postgres and the bundled victory-backend.exe as plain native Windows
    processes (RuntimeManager/RuntimeSetup). No container runtime, no
    WSL2, no elevation; see the k100-podman-wsl2-attempt tag for the
    abandoned approach this replaced and why.

    net8.0-windows + WinForms, not WPF/Avalonia: a tray icon and two small
    forms (first-run wizard, status) is the entire UI surface (K100 §26-28),
    and WinForms is the simplest framework that covers it (K100 §47's
    "choose the simplest framework" doctrine, applied to the launcher
    itself, not just the outer installer).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Generated from frontend/assets/favicon.png (6 sizes, 16-256px).
         Without this the compiled exe carries no icon resource at all,
         so Explorer/Start Menu/taskbar show Windows' generic default
         icon (confirmed on real hardware). The tray icon at runtime is
         a separate thing, set in code via AppIcon.cs; this is what a
         person sees before the app is even running. -->
    <ApplicationIcon>victory.ico</ApplicationIcon>
    <AssemblyName>VictoryLauncher</AssemblyName>
    <RootNamespace>VictoryLauncher</RootNamespace>
    <!-- Velopack ships self-contained, single-file-per-update-package apps. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      AppPaths.BackendExePath expects this at <output>\victory-backend.exe.
      Not checked in here: .github/workflows/windows-installer.yml
      cross-compiles it fresh from backend/cmd/victory (GOOS=windows,
      trivial from any host, no Windows toolchain needed for the Go side)
      and drops it in this directory before `dotnet publish` runs, so a
      local build without that CI step simply won't have this file yet.
    -->
    <None Include="victory-backend.exe" Condition="Exists('victory-backend.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Same file every page of the web app already links as its favicon (see AppIcon.cs). -->
    <None Include="favicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Static Caddyfile: root/proxy routes, see AppPaths.CaddyfilePath. -->
    <None Include="Caddyfile">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Third-party license attribution, shipped beside the exe in every install. -->
    <None Include="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      The whole repo's frontend/ tree, bundled as-is: the Go backend is
      API-only and never served these files itself (see AppPaths.FrontendRoot's
      comment). Caddy needs a real copy of them to serve statically.
      ~100MB, ~175 files as of this writing; not worth trimming further
      for a desktop app install.
    -->
    <FrontendFile Include="..\..\..\frontend\**\*.*" />
    <None Include="@(FrontendFile)">
      <Link>frontend\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Explicit even though net8.0-windows often carries these transitively:
         CI is the only place this ever actually builds, so an ambiguous
         "usually included" isn't worth the round-trip if it's wrong. -->
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>

</Project>
